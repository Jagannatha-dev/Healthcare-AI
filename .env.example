# ==========================================
# Healthcare-AI Environment Configuration
# ==========================================
# Copy this file to .env and fill in real values.
# The .env file is ignored by git (see .gitignore)
# so your credentials never enter version control.

# Flask secret key — generate a strong one:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-hex-string

# Oracle Database credentials
DB_USER=healthcare_ai
DB_PASSWORD=your-actual-password-here
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1

# Upload folder (relative to project root)
UPLOAD_FOLDER=uploads
